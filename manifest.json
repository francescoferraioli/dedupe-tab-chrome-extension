{
  "manifest_version": 3,
  "name": "Dedupe Tab",
  "version": "1.0.0",
  "description": "Prompts to switch to an existing tab when you open a duplicate URL.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}

{
  "name": "dedupe-tab-chrome-extension",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/background.ts --bundle --outfile=dist/background.js --format=esm --target=es2022 --minify && cp manifest.json dist/",
    "watch": "esbuild src/background.ts --bundle --outfile=dist/background.js --format=esm --target=es2022 --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
